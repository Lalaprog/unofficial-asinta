# Supabase — required for the app to run against a live project.
# Copy to .env.local (or .env) and fill in the values from
# Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Groq AI key used by /api/ai/categorize (server-side only).
GROQ_API_KEY=

# SMTP — server-side only
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# STARTTLS is REQUIRED by default on non-secure ports (587): without it a
# man-in-the-middle can strip STARTTLS and read credentials + message bodies.
# Set to false only for a localhost-only development mail catcher.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=

EMAIL_FROM_NAME=Asinta Architects
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
FIRM_CONTACT_NUMBER=

# Existing or required integrations
PHILSMS_API_KEY=
# Defaults to "PhilSMS" (the account's default sender ID). Custom sender IDs
# (e.g. ASINTA) must be requested and approved in the PhilSMS dashboard
# before they can be used here — otherwise the gateway rejects the message.
PHILSMS_SENDER_ID=PhilSMS

# Trusted scheduled operations
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Must remain disabled by default
AUTOMATIC_REMINDERS_ENABLED=false

# Session timeouts (public — the browser runs this clock). MUST match the
# Supabase project settings: auth.sessions.inactivity_timeout / timebox.
NEXT_PUBLIC_SESSION_IDLE_TIMEOUT_MINUTES=20
NEXT_PUBLIC_SESSION_ABSOLUTE_TIMEOUT_HOURS=8
# Warning lead time before the session ends.
NEXT_PUBLIC_SESSION_WARNING_SECONDS=120

# TOTP MFA for Founder accounts. Enrolment is always available in Settings;
# enforcement is opt-in so a Founder cannot be locked out before enrolling.
# Set to true only once every Founder has a verified authenticator factor.
MFA_ENFORCE_FOUNDERS=false

# Email-code sign-in remains off until MFA safeguards, Supabase Auth's SMTP and
# the Magic Link code template are verified. Configure BOTH only after rollout
# approval; the public switch is compiled into the application at build time.
EMAIL_CODE_SIGNIN_ENABLED=false
NEXT_PUBLIC_EMAIL_CODE_SIGNIN_ENABLED=false

# Optional model overrides (see lib/ai/models.ts). Defaults are the model IDs
# verified against the Groq docs on 2026-10-06; Groq retires models regularly,
# so these exist so a retirement is an env change, not a code change.
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=
GROQ_TRANSCRIBE_MODEL=

# Unfinished payroll/attendance foundation UI. Leave off on shared/production
# deployments. This public value is inlined during `next build`; changing it
# requires a rebuild. It is NOT an authorization or database safety control.
# Enable only in an isolated preview with matching schema and verified recovery.
NEXT_PUBLIC_FINANCE_FOUNDATION_PREVIEW=false

# Experimental weekly worker generate/approve/external-payment UI; requires the
# finance gate and all matching draft RPCs. Keep off on shared/production sites.
# This display flag is NOT authorization or a database compatibility check.
NEXT_PUBLIC_WEEKLY_WORKER_ACTIONS_PREVIEW=false

# Separate experimental revision-bound refresh UI. Requires the exact refresh
# candidate and action gates; never enable against the old approval signature.
NEXT_PUBLIC_WEEKLY_WORKER_REFRESH_PREVIEW=false
# Experimental approved-voucher return and revision-bound payment; all previous
# gates and the complete return candidate required. Never enable on shared sites.
NEXT_PUBLIC_WEEKLY_WORKER_RETURN_PREVIEW=false
# Read-only historical payment/Bale evidence; requires the uninstalled matching
# SQL candidates and finance gate. Never enable against shared production.
NEXT_PUBLIC_HISTORICAL_FINANCE_EVIDENCE_PREVIEW=false
# Separate experimental historical assertion entry; requires all evidence and
# writer candidates and coordinated cutover. Never enable on shared sites.
NEXT_PUBLIC_HISTORICAL_FINANCE_ENTRY_PREVIEW=false
# Experimental historical external worker-pay assertions without a voucher.
# Requires matching uninstalled guards and coordinated cutover; keep off.
NEXT_PUBLIC_HISTORICAL_EXTERNAL_WORKER_PREVIEW=false

# Experimental site-scoped weekly Bale release panel. Requires the finance gate
# and reviewed Bale drafts; keep off on shared/production deployments.
NEXT_PUBLIC_WEEKLY_BALE_RELEASE_PREVIEW=false

# Read-only rental links; draft database functions and compatible cutover required.
# This does not enable confirmation or prove payment.
NEXT_PUBLIC_CONFIRMED_RENTAL_PREVIEW=false
# Read-only paid worker allocations; excludes legacy costs and is not a total.
NEXT_PUBLIC_PROJECT_PAID_WORKER_EVIDENCE_PREVIEW=false
# Experimental unsaved project-cost reconciliation scratchpad; keep off.
NEXT_PUBLIC_PROJECT_COST_RECONCILIATION_PREVIEW=false
# Experimental incomplete durable review UI; also requires both gates above and
# the uninstalled reviewed database candidate. Do not enable on shared systems.
NEXT_PUBLIC_PROJECT_COST_REVIEW_LEDGER_PREVIEW=false
# Separate experimental write interface; never enable without the complete reviewed cutover.
NEXT_PUBLIC_RENTAL_CONFIRMATION_PREVIEW=false

# Experimental, independent worker-category catalog UI. Keep off on shared or
# production deployments. NEXT_PUBLIC values are inlined at build time; this
# is a display gate, not authorization or a check that the schema is installed.
NEXT_PUBLIC_WORKER_CATEGORY_PREVIEW=false

# Experimental paid-voucher adjustment cases, additionally gated by the finance
# foundation switch above. Keep off until matching schema and workflows are
# independently verified. Public build-time display switch, not authorization.
NEXT_PUBLIC_PAID_ADJUSTMENTS_PREVIEW=false

# Experimental Founder pending Supervisor leave indicator. Requires the finance
# switch and matching reviewed RPCs. Keep off on shared/production sites.
NEXT_PUBLIC_SUPERVISOR_LEAVE_NOTIFICATIONS_PREVIEW=false

# Experimental read-only regular/OT history and project log enrichment. Requires
# the finance gate and uninstalled attendance history time batch RPC; keep off.
NEXT_PUBLIC_ATTENDANCE_TIME_HISTORY_PREVIEW=false

# Experimental Supervisor payroll planning preview, in addition to the finance
# foundation switch. Keep off until its matching read-only RPCs are reviewed.
NEXT_PUBLIC_SUPERVISOR_PAYROLL_PREVIEW=false
# Experimental Supervisor payroll ledger and company-evidence preview. Requires
# the planning gate and a coordinated uninstalled backend. Keep off.
NEXT_PUBLIC_SUPERVISOR_PAYROLL_LEDGER_PREVIEW=false
# Experimental paid-period cases for the Supervisor and external-worker drafts.
# Requires all matching uninstalled backends and coordinated cutover; keep off.
NEXT_PUBLIC_PAID_PERIOD_ASSERTION_CASES_PREVIEW=false

# Experimental owned-equipment allocation workspace and matching draft RPCs.
# Keep off on shared/production deployments until old-client and Supervisor
# views, migration, permissions and recovery are reviewed.
NEXT_PUBLIC_OWNED_EQUIPMENT_PREVIEW=false

# Uninstalled Founder-only assignment-history candidate; not a schema check.
NEXT_PUBLIC_ASSIGNMENT_HISTORY_PREVIEW=false

# Experimental private Supervisor portrait in Founder Team Accounts. The draft
# backend is uninstalled; do not enable on shared/production deployments.
# This build-time UI switch is not a permission check or installation test.
NEXT_PUBLIC_SUPERVISOR_PORTRAIT_PREVIEW=false

# Experimental Founder-only atomic project move, additionally requires the
# assignment-history display gate and both reviewed backend drafts. Keep off.
NEXT_PUBLIC_ATOMIC_WORKER_MOVE_PREVIEW=false
