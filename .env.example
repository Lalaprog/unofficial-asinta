# Supabase — required for the app to run against a live project.
# Copy to .env.local (or .env) and fill in the values from
# Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Groq AI key used by /api/ai/categorize (server-side only).
GROQ_API_KEY=

# SMTP — server-side only
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# STARTTLS is REQUIRED by default on non-secure ports (587): without it a
# man-in-the-middle can strip STARTTLS and read credentials + message bodies.
# Set to false only for a localhost-only development mail catcher.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=

EMAIL_FROM_NAME=Asinta Architects
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
FIRM_CONTACT_NUMBER=

# Existing or required integrations
PHILSMS_API_KEY=
# Defaults to "PhilSMS" (the account's default sender ID). Custom sender IDs
# (e.g. ASINTA) must be requested and approved in the PhilSMS dashboard
# before they can be used here — otherwise the gateway rejects the message.
PHILSMS_SENDER_ID=PhilSMS

# Trusted scheduled operations
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Must remain disabled by default
AUTOMATIC_REMINDERS_ENABLED=false

# Session timeouts (public — the browser runs this clock). MUST match the
# Supabase project settings: auth.sessions.inactivity_timeout / timebox.
NEXT_PUBLIC_SESSION_IDLE_TIMEOUT_MINUTES=20
NEXT_PUBLIC_SESSION_ABSOLUTE_TIMEOUT_HOURS=8
# Warning lead time before the session ends.
NEXT_PUBLIC_SESSION_WARNING_SECONDS=120

# TOTP MFA for Founder accounts. Enrolment is always available in Settings;
# enforcement is opt-in so a Founder cannot be locked out before enrolling.
# Set to true only once every Founder has a verified authenticator factor.
MFA_ENFORCE_FOUNDERS=false

# Email-code sign-in remains off until MFA safeguards, Supabase Auth's SMTP and
# the Magic Link code template are verified. Configure BOTH only after rollout
# approval; the public switch is compiled into the application at build time.
EMAIL_CODE_SIGNIN_ENABLED=false
NEXT_PUBLIC_EMAIL_CODE_SIGNIN_ENABLED=false

# Optional model overrides (see lib/ai/models.ts). Defaults are the model IDs
# verified against the Groq docs on 2026-10-06; Groq retires models regularly,
# so these exist so a retirement is an env change, not a code change.
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=
GROQ_TRANSCRIBE_MODEL=

# Unfinished payroll/attendance foundation UI. Leave off on shared/production
# deployments. This public value is inlined during `next build`; changing it
# requires a rebuild. It is NOT an authorization or database safety control.
# Enable only in an isolated preview with matching schema and verified recovery.
NEXT_PUBLIC_FINANCE_FOUNDATION_PREVIEW=false

# Experimental, independent worker-category catalog UI. Keep off on shared or
# production deployments. NEXT_PUBLIC values are inlined at build time; this
# is a display gate, not authorization or a check that the schema is installed.
NEXT_PUBLIC_WORKER_CATEGORY_PREVIEW=false

# Experimental paid-voucher adjustment cases, additionally gated by the finance
# foundation switch above. Keep off until matching schema and workflows are
# independently verified. Public build-time display switch, not authorization.
NEXT_PUBLIC_PAID_ADJUSTMENTS_PREVIEW=false

# Experimental Founder pending Supervisor leave indicator. Requires the finance
# switch and matching reviewed RPCs. Keep off on shared/production sites.
NEXT_PUBLIC_SUPERVISOR_LEAVE_NOTIFICATIONS_PREVIEW=false

# Experimental Supervisor payroll planning preview, in addition to the finance
# foundation switch. Keep off until its matching read-only RPCs are reviewed.
NEXT_PUBLIC_SUPERVISOR_PAYROLL_PREVIEW=false
